<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'">
<title>AD Exposure Comparison{% if d.new.client %} · {{ d.new.client }}{% endif %}</title>
<style>
{% include "_style.css" %}
</style>
</head>
<body>
<header class="masthead">
  <div class="wrap masthead-inner">
    <div>
      <p class="eyebrow">Active Directory exposure · comparison</p>
      <h1>{{ d.new.client or d.old.client or "Report comparison" }}</h1>
      <p class="meta">Baseline data {{ d.old.reference_date or "?" }} → current data {{ d.new.reference_date or "?" }}
        {% if d.new.redacted %}<span class="pill">Redacted</span>{% endif %}</p>
    </div>
    <div class="toolbar no-print">
      <button type="button" class="btn" id="theme-toggle" aria-label="Toggle light or dark theme">&#9680; Theme</button>
      <button type="button" class="btn" id="print-btn">Print</button>
    </div>
  </div>
</header>
<main class="wrap">
  {% for w in d.warnings %}<div class="card sev-high">{{ w }}</div>{% endfor %}
  <div class="summary-grid">
    <div class="card">
      <h3>Risk score</h3>
      <div class="score-rating">{{ d.old.risk.score | fmt }} → {{ d.new.risk.score | fmt }}</div>
      <div class="muted small">{{ d.old.risk.rating | fmt }} → {{ d.new.risk.rating | fmt }}
        {% if d.risk_delta is not none %}({{ "%+d" | format(d.risk_delta) }}){% endif %}</div>
    </div>
    <div class="card">
      <h3>Findings</h3>
      <dl class="kv">
        <dt>New</dt><dd class="diff-new">{{ d.summary.new }}</dd>
        <dt>Resolved</dt><dd class="diff-resolved">{{ d.summary.resolved }}</dd>
        <dt>Persisting</dt><dd>{{ d.summary.persisting }}</dd>
      </dl>
    </div>
    <div class="card">
      <h3>Affected objects</h3>
      <dl class="kv">
        <dt>Newly affected</dt><dd class="diff-new">{{ d.summary.new_objects }}</dd>
        <dt>No longer affected</dt><dd class="diff-resolved">{{ d.summary.resolved_objects }}</dd>
      </dl>
    </div>
  </div>

  {% macro finding_table(items, empty) %}
  {% if items %}
  <div class="table-scroll">
  <table class="data sortable compact">
    <thead><tr><th>ID</th><th data-type="num">Severity</th><th>Title</th><th data-type="num" class="num">Affected</th></tr></thead>
    <tbody>
    {% for f in items %}
      <tr><td class="mono">{{ f.id }}</td>
        <td data-value="{{ {'Critical':4,'High':3,'Medium':2,'Low':1}.get(f.severity, 0) }}"><span class="sev sev-{{ f.severity | lower }}">{{ f.severity }}</span></td>
        <td>{{ f.title }}</td><td class="num">{{ f.affected_count }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% else %}<p class="empty">{{ empty }}</p>{% endif %}
  {% endmacro %}

  <h2>New findings</h2>
  {{ finding_table(d.new_findings, "No new findings.") }}
  <h2>Resolved findings</h2>
  {{ finding_table(d.resolved_findings, "No findings were resolved.") }}

  <h2>Persisting findings</h2>
  {% if d.persisting_findings %}
  {% for p in d.persisting_findings %}
  <div class="card">
    <h3><span class="sev sev-{{ p.severity | lower }}">{{ p.severity }}</span> {{ p.title }} <span class="muted mono small">{{ p.id }}</span></h3>
    <p class="small muted">
      {% if p.severity_changed %}Severity changed from {{ p.old_severity }} to {{ p.severity }}. {% endif %}
      {{ p.persisting_objects }} unchanged ·
      <span class="diff-new">+{{ p.new_objects | length }} new</span> ·
      <span class="diff-resolved">&minus;{{ p.resolved_objects | length }} resolved</span>
    </p>
    {% if p.new_objects or p.resolved_objects %}
    <div class="table-scroll">
    <table class="data compact">
      <thead><tr><th>Change</th><th>Name</th><th>Type</th><th>Key</th></tr></thead>
      <tbody>
      {% for a in p.new_objects %}<tr><td class="diff-new">New</td><td class="name">{{ a.name }}</td><td>{{ a.type }}</td><td class="mono small name">{{ a.key }}</td></tr>{% endfor %}
      {% for a in p.resolved_objects %}<tr><td class="diff-resolved">Resolved</td><td class="name">{{ a.name }}</td><td>{{ a.type }}</td><td class="mono small name">{{ a.key }}</td></tr>{% endfor %}
      </tbody>
    </table>
    </div>
    {% endif %}
  </div>
  {% endfor %}
  {% else %}<p class="empty">No persisting findings.</p>{% endif %}
</main>
<footer class="wrap">Generated by houndreport. Self-contained offline report.</footer>
<script>
{% include "_script.js" %}
</script>
</body>
</html>
